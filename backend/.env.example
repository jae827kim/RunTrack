# Docker Compose만 사용할 때는 저장소 루트의 .env.example을 복사하세요.
# 이 파일은 Python을 호스트에서 직접 실행하며 Compose의 DB/Redis에 접속할 때 사용합니다.
# 아래 비밀번호는 루트 .env의 POSTGRES_PASSWORD/REDIS_PASSWORD와 같게 바꾸세요.
# URL에는 16진수 비밀번호를 권장하며, 특수문자를 쓰면 URL 인코딩이 필요합니다.
DATABASE_URL=postgresql://runtrack_user:replace_with_random_hex@localhost:5432/runtrack

# Redis
REDIS_URL=redis://:replace_with_random_hex@localhost:6379/0

# JWT & 보안
# 아래 값은 예시입니다. 로컬에서 생성한 랜덤 값으로 교체하고 .env는 커밋하지 마세요.
# 생성 명령: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 키
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENWEATHER_API_KEY=your-openweather-api-key

# 환경
DEBUG=False
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
