<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 네트워크 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.runtrack.RunTrackApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RunTrack"
        tools:targetApi="31">

        <!-- MainActivity -->
        <activity
            android:name="com.runtrack.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RunTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Maps API 메타데이터 -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCCCAkyKbyD_k33m7oVpjFVnJv7o0Uj8Ag" />

        <!-- Add the location service here when its implementation is available. -->

    </application>

</manifest>
